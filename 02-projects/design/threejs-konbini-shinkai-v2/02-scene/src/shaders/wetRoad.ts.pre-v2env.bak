import {
  Color,
  Matrix4,
  PlaneGeometry,
  ShaderMaterial,
  Vector2,
  Vector3,
  Vector4,
  type Camera,
  type Scene,
  type WebGLRenderer,
} from 'three';
import { Reflector } from 'three/addons/objects/Reflector.js';
import type { EnvUniformSnapshot } from '../env/Environment';
import { Hex } from '../env/palette';

/**
 * True planar reflection (Reflector) blended with procedural wet asphalt
 * and irregular puddle masks. This is the still-frame ground hero.
 */
const wetFrag = /* glsl */ `
uniform vec3 color;
uniform sampler2D tDiffuse;
uniform float uWetness;
uniform vec3 uSkyHorizon;
uniform vec3 uSkyZenith;
uniform vec3 uSunColor;
uniform vec3 uLampTint;
uniform float uNight;
uniform vec2 uMapScale;

varying vec4 vUv;
varying vec3 vWorldPos;
varying vec3 vWorldNormal;
varying vec3 vViewDir;

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}
float fbm(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  for (int i = 0; i < 5; i++) {
    v += a * noise(p);
    p *= 2.07;
    a *= 0.5;
  }
  return v;
}

void main() {
  // Planar reflection sample (from Reflector)
  vec3 coord = vUv.xyz / max(vUv.w, 1e-4);
  vec2 ruv = coord.xy;
  // Subtle ripple distortion in puddles
  vec2 wp = vWorldPos.xz * uMapScale;
  float ripple = (noise(wp * 18.0 + uNight) - 0.5) * 0.008 * uWetness;
  vec4 refl = texture2DProj(tDiffuse, vec4(vUv.xy + ripple * vUv.w, vUv.zw));

  // Procedural asphalt: dark binder + aggregate flecks + faint cracks
  float agg = noise(wp * 42.0);
  float fleck = smoothstep(0.62, 0.85, noise(wp * 90.0));
  float crack = smoothstep(0.48, 0.51, abs(fbm(wp * 3.5) - 0.5));
  vec3 dry = color * (0.78 + agg * 0.28);
  dry += vec3(0.04, 0.042, 0.048) * fleck;
  dry *= 1.0 - crack * 0.35;

  vec3 wetCol = dry * vec3(0.32, 0.34, 0.38);
  wetCol += vec3(0.02, 0.025, 0.035);

  // Irregular puddle islands
  float puddle = smoothstep(0.46, 0.68, fbm(wp * 0.55 + 2.7));
  puddle *= smoothstep(0.15, 0.45, uWetness);
  float wetField = mix(uWetness * 0.72, 1.0, puddle);

  vec3 n = normalize(vWorldNormal);
  vec3 v = normalize(vViewDir);
  float fres = pow(1.0 - max(0.0, dot(n, v)), 2.8);

  // Mirror amount: puddles almost full, remaining wet road still reads sky/store
  float mirror = mix(0.38, 0.95, fres) * wetField;
  mirror = mix(mirror, mix(0.7, 0.98, fres), puddle * uWetness);

  vec3 asphalt = mix(dry, wetCol, wetField);
  vec3 refCol = refl.rgb;
  float lum = dot(refCol, vec3(0.3, 0.5, 0.2));
  // Always keep a readable amber/indigo sky streak so wetness never looks matte-black
  float up = clamp(v.y * 0.85 + 0.15, 0.0, 1.0);
  vec3 skyFb = mix(uSkyHorizon * 1.15, uSkyZenith, pow(up, 0.8));
  skyFb += uSunColor * pow(up, 6.0) * 0.45;
  refCol = mix(skyFb, refCol * 1.08, smoothstep(0.02, 0.12, lum));

  refCol += uLampTint * (0.12 + uNight * 0.18) * puddle;
  refCol += uSunColor * pow(max(0.0, v.y), 5.0) * 0.22 * uWetness;

  vec3 col = mix(asphalt, refCol, clamp(mirror, 0.0, 1.0));

  gl_FragColor = vec4(col, 1.0);

  #include <tonemapping_fragment>
  #include <colorspace_fragment>
}
`;

const wetVert = /* glsl */ `
uniform mat4 textureMatrix;
varying vec4 vUv;
varying vec3 vWorldPos;
varying vec3 vWorldNormal;
varying vec3 vViewDir;

void main() {
  vec4 world = modelMatrix * vec4(position, 1.0);
  vWorldPos = world.xyz;
  vWorldNormal = normalize(mat3(modelMatrix) * normal);
  vViewDir = cameraPosition - world.xyz;
  vUv = textureMatrix * world;
  gl_Position = projectionMatrix * viewMatrix * world;
}
`;

export function createWetRoad(width = 42, depth = 36): Reflector {
  const geo = new PlaneGeometry(width, depth, 1, 1);
  geo.rotateX(-Math.PI / 2);

  const reflector = new Reflector(geo, {
    clipBias: 0.003,
    textureWidth: 1024,
    textureHeight: 1024,
    color: new Color(Hex.wetBlack),
    shader: {
      uniforms: {
        color: { value: new Color(Hex.wetBlack) },
        tDiffuse: { value: null },
        textureMatrix: { value: new Matrix4() },
        uWetness: { value: 1 },
        uSkyHorizon: { value: new Color(Hex.amberKey) },
        uSkyZenith: { value: new Color(Hex.deepIndigo) },
        uSunColor: { value: new Color(0xffd2a0) },
        uLampTint: { value: new Color(Hex.warmPaper) },
        uNight: { value: 0.6 },
        uMapScale: { value: new Vector2(1, 1) },
      },
      vertexShader: wetVert,
      fragmentShader: wetFrag,
    },
  });
  reflector.name = 'wet_road';
  reflector.position.set(0, 0, 3.2);
  return reflector;
}

export function applyWetRoad(road: Reflector, u: EnvUniformSnapshot): void {
  const mat = road.material as ShaderMaterial;
  if (!mat.uniforms.uWetness) return;
  mat.uniforms.uWetness.value = u.wetness;
  (mat.uniforms.uSkyHorizon.value as Color).setRGB(
    u.skyHorizon[0],
    u.skyHorizon[1],
    u.skyHorizon[2],
  );
  (mat.uniforms.uSkyZenith.value as Color).setRGB(
    u.skyZenith[0],
    u.skyZenith[1],
    u.skyZenith[2],
  );
  (mat.uniforms.uSunColor.value as Color).setRGB(
    u.sunColor[0],
    u.sunColor[1],
    u.sunColor[2],
  );
  mat.uniforms.uNight.value = u.nightFactor;
}

/** Keep TypeScript quiet if these three.js types are referenced later. */
export type RoadUpdateCtx = {
  renderer: WebGLRenderer;
  scene: Scene;
  camera: Camera;
  viewport?: Vector4;
  eye?: Vector3;
};

export function createSidewalkMaterialColor(): number {
  return 0x6a6762;
}
